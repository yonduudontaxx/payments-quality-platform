{
  "name": "payments-quality-platform",
  "version": "1.0.0",
  "description": "Payments quality platform — modular monolith for testing payment gateway flows",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "test:unit": "jest --testPathPattern=test/unit",
    "test:integration": "jest --runInBand --forceExit --testPathPattern=test/integration",
    "test:e2e": "playwright test",
    "test": "npm run test:unit",
    "ci": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run report",
    "report": "allure generate allure-results/jest allure-results/playwright --output allure-report --open"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yonduudontaxx/payments-quality-platform.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/yonduudontaxx/payments-quality-platform/issues"
  },
  "homepage": "https://github.com/yonduudontaxx/payments-quality-platform#readme",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/sensible": "^6.0.4",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "allure": "^3.9.0",
    "allure-jest": "^3.9.0",
    "allure-playwright": "^3.9.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "wait-on": "^9.0.10"
  }
}
