{
  "name": "payments-quality-platform",
  "version": "1.0.0",
  "description": "Payments quality platform — modular monolith for testing payment gateway flows",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "test:unit": "jest --testPathPatterns=test/unit",
    "test:integration": "jest --runInBand --forceExit --testPathPatterns=test/integration",
    "test:security": "jest --runInBand --forceExit --testPathPatterns=test/security",
    "test:e2e": "playwright test",
    "test": "npm run test:unit",
    "clean:results": "rm -rf allure-results/jest allure-results/playwright && mkdir -p allure-results/jest allure-results/playwright",
    "report:generate": "allure generate allure-results/jest allure-results/playwright --output allure-report",
    "report:open": "allure open allure-report",
    "report": "npm run report:generate && npm run report:open",
    "ci": "npm run clean:results && npm run test:unit && npm run test:integration && npm run test:e2e && npm run report:generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yonduudontaxx/payments-quality-platform.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/yonduudontaxx/payments-quality-platform/issues"
  },
  "homepage": "https://github.com/yonduudontaxx/payments-quality-platform#readme",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^25.9.9",
    "@types/supertest": "^7.2.1",
    "allure": "^3.9.0",
    "allure-jest": "^3.14.0",
    "allure-playwright": "^3.9.0",
    "jest": "^30.5.2",
    "jest-util": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
